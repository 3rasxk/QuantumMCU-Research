# --- macOS ---
.DS_Store

# --- Secrets / local env (none currently tracked -- kept ignored by default) ---
.env
.env.*
*.pem
*.key

# --- Python ---
.venv/
__pycache__/
*.py[cod]

# --- Editors ---
.idea/
*.swp

# --- PlatformIO build output (regenerated by `pio run`) ---
.pio/
*.o
*.elf
*.a
firmware/*/.cache/
compile_commands.json

# PlatformIO / VS Code machine-specific paths
**/.vscode/.browse.c_cpp.db*
**/.vscode/c_cpp_properties.json
**/.vscode/launch.json
**/.vscode/ipch

# --- Compiled PC binary (rebuild with pc/phase1_validate/build.sh) ---
pc/phase1_validate/phase1_validate

# --- Microsoft Word lock files ---
~$*.docx

# --- pc/run.py --fresh archive (moved-aside old data, never committed by
#     design -- see README.md "Fresh runs and the archive" and
#     run_log.md's 2026-09-21 entry) ---
data/archive/*
# full-restart archives (2026-10-03) are committed on purpose: they are the
# retired dataset, kept for the record and verified by MANIFEST.json
!data/archive/restart_*/
